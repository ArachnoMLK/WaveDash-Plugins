{
  "wdsh": 1,
  "id": "wavedash.brawlhalla-api",
  "name": "Brawlhalla (official API)",
  "version": "1.2.1",
  "author": "WaveDash",
  "description": {
    "en": "Your Brawlhalla profile through the official API: 1v1 and 2v2 ELO, peak, rankings, games, wins, level, and per-legend stats. Requires a personal key from Blue Mammoth Games.",
    "fr": "Ton profil Brawlhalla par l'API officielle : ELO 1v1 et 2v2, pic, classements, parties, victoires, niveau, et le détail par légende. Demande une clé personnelle de Blue Mammoth Games."
  },
  "permissions": { "network": ["api.brawlhalla.com"], "folder": false },
  "notices": true,
  "inputs": [
    { "key": "player", "type": "text", "required": true, "placeholder": "7656119… / 1234567",
      "label": { "en": "Brawlhalla ID, Steam ID or Steam profile link", "fr": "ID Brawlhalla, Steam ID ou lien de profil Steam" } }
  ],
  "secrets": [
    { "key": "apiKey", "label": { "en": "Brawlhalla API key", "fr": "Clé API Brawlhalla" },
      "help": { "en": "Personal key to request from Blue Mammoth Games (developer portal / official Discord).", "fr": "Clé personnelle à demander à Blue Mammoth Games (portail développeur / Discord officiel)." } }
  ],
  "metrics": [
    { "key": "elo_1v1", "label": { "en": "1v1 ELO", "fr": "ELO 1v1" }, "primary": true, "milestone": { "increment": 100, "notifyDown": true } },
    { "key": "peak_1v1", "label": { "en": "1v1 peak ELO", "fr": "ELO max 1v1" } },
    { "key": "elo_2v2", "label": { "en": "2v2 ELO", "fr": "ELO 2v2" }, "milestone": { "increment": 100, "notifyDown": true } },
    { "key": "games", "label": { "en": "Games", "fr": "Parties" } },
    { "key": "wins", "label": { "en": "Wins", "fr": "Victoires" } },
    { "key": "winrate", "label": { "en": "Win rate", "fr": "Taux de victoire" }, "format": "percent", "decimals": 1 },
    { "key": "level", "label": { "en": "Level", "fr": "Niveau" } },
    { "key": "global_rank", "label": { "en": "Global rank", "fr": "Classement mondial" }, "format": "rank" },
    { "key": "region_rank", "label": { "en": "Region rank", "fr": "Classement régional" }, "format": "rank" }
  ],
  "itemColumns": [
    { "key": "games", "label": { "en": "Games", "fr": "Parties" } },
    { "key": "wins", "label": { "en": "Wins", "fr": "Victoires" } },
    { "key": "winrate", "label": { "en": "Win %", "fr": "% V" }, "unit": "%" },
    { "key": "kos", "label": "KOs" },
    { "key": "falls", "label": { "en": "Falls", "fr": "Chutes" } },
    { "key": "level", "label": { "en": "Level", "fr": "Niveau" } },
    { "key": "time", "label": { "en": "Play time", "fr": "Temps de jeu" }, "unit": "h" }
  ],
  "refreshMinutes": 30
}
