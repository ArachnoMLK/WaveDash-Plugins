{
  "wdsh": 1,
  "id": "wavedash.brawlhalla-replays",
  "name": "Brawlhalla Replays",
  "version": "1.11.0",
  "minAppVersion": "1.7.0",
  "author": "WaveDash",
  "description": {
    "en": "Reads your Brawlhalla .replay files from a folder: wins, losses, stocks, duration, and a detail view per match (players, scores, KO timeline). Everything is read locally, no network access.",
    "fr": "Lit tes fichiers .replay Brawlhalla dans un dossier : victoires, défaites, stocks, durée, et le détail de chaque partie (joueurs, scores, frise des KOs). Tout est lu en local, aucun accès réseau."
  },
  "permissions": {
    "network": [],
    "folder": true,
    "folderExtensions": [
      ".replay"
    ],
    "images": true
  },
  "inputs": [
    {
      "key": "folder",
      "type": "folder",
      "required": true,
      "label": {
        "en": "Replays folder",
        "fr": "Dossier des replays"
      },
      "help": {
        "en": "In game: Brawlhalla > Replays, or the folder where you save them.",
        "fr": "Dans le jeu : Brawlhalla > Replays, ou le dossier où tu les enregistres."
      }
    },
    {
      "key": "playerName",
      "type": "text",
      "required": true,
      "label": {
        "en": "Your in-game name",
        "fr": "Ton pseudo en jeu"
      },
      "placeholder": "Pseudo",
      "help": {
        "en": "Used to know which matches you won. The clan tag can be omitted. Several names: separate them with commas.",
        "fr": "Sert à savoir quelle partie tu as gagnée. Le tag de clan peut être omis. Plusieurs pseudos : sépare-les par des virgules."
      }
    },
    {
      "key": "thumbs",
      "type": "images",
      "required": false,
      "label": {
        "en": "Map thumbnails (optional)",
        "fr": "Vignettes des cartes (facultatif)"
      },
      "help": {
        "en": "Your game's images\\thumbnails folder, for example C:\\Program Files (x86)\\Steam\\steamapps\\common\\Brawlhalla\\images\\thumbnails. WaveDash shows each match's map thumbnail from it; the plugin does not read this folder.",
        "fr": "Le dossier images\\thumbnails de ton jeu, par exemple C:\\Program Files (x86)\\Steam\\steamapps\\common\\Brawlhalla\\images\\thumbnails. WaveDash y affiche la vignette de la carte de chaque partie ; le plugin ne lit pas ce dossier."
      }
    }
  ],
  "metrics": [
    {
      "key": "games",
      "label": {
        "en": "Games",
        "fr": "Parties"
      },
      "primary": true
    },
    {
      "key": "wins",
      "label": {
        "en": "Wins",
        "fr": "Victoires"
      }
    },
    {
      "key": "losses",
      "label": {
        "en": "Losses",
        "fr": "Défaites"
      }
    },
    {
      "key": "winrate",
      "label": {
        "en": "Win rate",
        "fr": "Taux de victoire"
      },
      "format": "percent",
      "decimals": 1
    },
    {
      "key": "stocks_taken",
      "label": {
        "en": "Stocks taken",
        "fr": "Stocks pris à l'adversaire"
      }
    },
    {
      "key": "stocks_lost",
      "label": {
        "en": "Stocks lost",
        "fr": "Stocks perdus"
      }
    },
    {
      "key": "avg_duration",
      "label": {
        "en": "Average length",
        "fr": "Durée moyenne"
      },
      "format": "duration"
    },
    {
      "key": "apm",
      "label": {
        "en": "Presses per minute",
        "fr": "Appuis par minute"
      },
      "decimals": 0
    }
  ],
  "itemColumns": [
    {
      "key": "mode",
      "label": {
        "en": "Mode",
        "fr": "Mode"
      }
    },
    {
      "key": "patch",
      "label": {
        "en": "Patch",
        "fr": "Patch"
      }
    },
    {
      "key": "result",
      "label": {
        "en": "Result",
        "fr": "Résultat"
      }
    },
    {
      "key": "duration",
      "label": {
        "en": "Length",
        "fr": "Durée"
      }
    },
    {
      "key": "kos",
      "label": {
        "en": "KOs (total)",
        "fr": "KOs (total)"
      }
    },
    {
      "key": "apm",
      "label": {
        "en": "Presses/min",
        "fr": "Appuis/min"
      }
    },
    {
      "key": "map",
      "label": {
        "en": "Map",
        "fr": "Carte"
      }
    }
  ],
  "itemsMode": "keep",
  "refreshMinutes": 10,
  "search": true,
  "cross": {
    "measures": [
      {
        "key": "games",
        "label": {
          "en": "Games",
          "fr": "Parties"
        }
      },
      {
        "key": "wins",
        "label": {
          "en": "Wins",
          "fr": "Victoires"
        }
      },
      {
        "key": "losses",
        "label": {
          "en": "Losses",
          "fr": "Défaites"
        }
      },
      {
        "key": "winrate",
        "label": {
          "en": "Win %",
          "fr": "% de victoire"
        }
      }
    ],
    "dimensions": [
      {
        "key": "legend",
        "label": {
          "en": "Legends",
          "fr": "Légendes"
        }
      },
      {
        "key": "map",
        "label": {
          "en": "Maps",
          "fr": "Cartes"
        }
      },
      {
        "key": "mode",
        "label": {
          "en": "Modes",
          "fr": "Modes"
        }
      },
      {
        "key": "result",
        "label": {
          "en": "Result",
          "fr": "Résultat"
        }
      },
      {
        "key": "side",
        "label": {
          "en": "With / against",
          "fr": "Avec / contre"
        }
      },
      {
        "key": "month",
        "label": {
          "en": "Month",
          "fr": "Mois"
        }
      },
      {
        "key": "weekday",
        "label": {
          "en": "Day",
          "fr": "Jour"
        }
      },
      {
        "key": "hour",
        "label": {
          "en": "Hour",
          "fr": "Heure"
        }
      }
    ]
  },
  "views": true,
  "players": true
}
